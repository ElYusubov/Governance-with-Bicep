            "effect": {
              "type": "string",
              "defaultValue": "audit",
              "allowedValues": [
                "audit",
                "deny"
              ],
              "metadata": {
                "description": "Policy effect"
              }
            },
            "policyName": {
              "type": "string",
              "defaultValue": "storage-access-controls-policy-14",
              "metadata": {
                "description": "Policy name"
              }
            },
